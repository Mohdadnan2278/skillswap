{
  "name": "skillswap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "supabase": "node scripts/supabase-local.mjs",
    "db:start": "npm run supabase -- start --exclude studio,realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "npm run supabase -- stop",
    "test:integration": "playwright test auth-profiles.spec.ts skills-matching.spec.ts bookings.spec.ts credits.spec.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
