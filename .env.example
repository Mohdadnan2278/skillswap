# Copy to .env.local; never commit real local configuration.
# Project Settings > API: use a publishable key, NEVER a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Exact app origin, no path. Use your HTTPS origin for hosting.
SITE_URL=http://127.0.0.1:3000
# Enable only after configuring Google in Supabase and Google Cloud.
GOOGLE_AUTH_ENABLED=false

# Embedded public Jitsi option; Google Meet links work alongside it without keys.
# No video API key or video server needed.
# Room links are not protected by SkillSwap once shared outside the app.
VIDEO_PROVIDER=jitsi_demo
# Enable only after configuring and testing a real SMTP sender. Defaults off on hosted sites,
# on for the loopback local test inbox. An explicit value overrides either default.
# EMAIL_DELIVERY_ENABLED=false
# Optional non-secret project reference for management commands.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN belongs only in secure management environment settings.
